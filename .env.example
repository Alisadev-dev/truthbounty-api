DB_SSL=false                # Enable SSL for PostgreSQL (set 'true' in production)

# ==============================================
# Database Pool, Statement, and Transaction Budgets (PREWAVE-BE-056)
# ==============================================
# All values are clamped into safe ranges at startup (fail-closed), so a
# misconfigured value degrades to a bounded pool instead of allowing
# unbounded connection use. See src/database/pool.config.ts.
#
# Pool sizing
DB_POOL_MAX=20                              # Max connections (clamped 1-100)
DB_POOL_MIN=2                               # Min idle connections (clamped 0-50)
DB_POOL_ACQUIRE_TIMEOUT=30000               # Acquisition timeout in ms (clamped 1s-120s)
DB_POOL_IDLE_TIMEOUT=                       # Idle connection timeout (ms); derived from acquire/idle-tx timeouts if unset
#
# Statement / transaction cancellation (applied server-side via GUCs)
DB_STATEMENT_TIMEOUT=15000                  # Cancels a single runaway statement (ms, clamped 1s-60s)
DB_IDLE_TRANSACTION_TIMEOUT=10000           # Terminates a leaked/idle transaction (ms, clamped 1s-60s)
DB_TRANSACTION_DEADLINE=30000               # App-side whole-transaction deadline (ms, clamped 1s-300s)
#
# Per-workload connection budgets (background jobs get a separate slice so
# job bursts cannot starve interactive API requests)
DB_POOL_BUDGET_API=                         # HTTP handlers (default: 60% of DB_POOL_MAX)
DB_POOL_BUDGET_JOBS=                        # BullMQ/cron/outbox jobs (default: 30% of DB_POOL_MAX)
DB_POOL_BUDGET_ADMIN=                       # Admin/probes/health (default: 10% of DB_POOL_MAX)
DB_POOL_BUDGET_DEFAULT=                     # Fallback workload (default: 50% of DB_POOL_MAX)

